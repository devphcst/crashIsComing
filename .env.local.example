# Vercel KV (Vercel 대시보드에서 KV 생성 시 자동 주입)
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=

# 관리자 인증 토큰 (예측 불가능한 긴 랜덤 문자열로 설정)
ADMIN_TOKEN=

# Provider 선택: manual | yahoo
#   manual: 운영자가 /admin에서 매일 종가 입력
#   yahoo:  매일 22:00 UTC cron이 Yahoo Finance adjusted close를 KV에 자동 저장
DATA_PROVIDER=manual

# Yahoo 자동 수집 사용 시 필수 — Vercel Cron이 Authorization: Bearer로 전송
CRON_SECRET=
