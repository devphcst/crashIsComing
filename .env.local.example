# Vercel KV (Vercel 대시보드에서 KV 생성 시 자동 주입)
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=

# 관리자 인증 토큰 (예측 불가능한 긴 랜덤 문자열로 설정)
ADMIN_TOKEN=

# Provider 선택: manual | twelvedata
#   manual:     운영자가 /admin에서 매일 종가 입력
#   twelvedata: 매일 22:00 UTC (07:00 KST) cron이 Twelve Data API로 종가 자동 수집
DATA_PROVIDER=manual

# Vercel Cron 인증 — Authorization: Bearer <secret>로 전송
CRON_SECRET=

# Twelve Data API key — DATA_PROVIDER=twelvedata 사용 시 필수.
# https://twelvedata.com/ 가입 후 무료 키 발급 (800 credits/day, 8 req/min).
TWELVE_DATA_API_KEY=

# Discord webhook URL — 자동화 실패/복구/감시 알림 발송 채널.
# Discord 서버 > 채널 > 통합 > 웹훅 만들기 > URL 복사.
# 미설정 시 알림 발송 안 되고 console.warn으로 폴백.
DISCORD_WEBHOOK_URL=


